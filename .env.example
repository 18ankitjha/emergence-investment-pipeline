# Pick a provider by setting its key. If neither is set, the pipeline runs a
# clearly labelled deterministic fallback so the artifacts stay inspectable.

# Google AI Studio (free tier, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional. "gemini" or "openai". Defaults to whichever key is present,
# preferring gemini.
LLM_PROVIDER=

# Optional. Candidates analysed in parallel (default 3). Drop to 1 if a free
# tier keeps rate-limiting.
PIPELINE_CONCURRENCY=
